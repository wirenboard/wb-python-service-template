#!/usr/bin/make -f

# tests/test_version.py reads the version from the package metadata, and pybuild writes that
# metadata only at the install stage, which runs after the tests. Generate it into the build
# directory beforehand and remove it afterwards, so the test stage leaves the tree as it found it.
export PYBUILD_BEFORE_TEST=cd {dir} && {interpreter} setup.py --quiet egg_info --egg-base {build_dir}
export PYBUILD_AFTER_TEST=rm -rf {build_dir}/*.egg-info

%:
	dh $@ --with python3 --buildsystem=pybuild
